---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import type { InferEntrySchema } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const creative = await getCollection("creative");

const projects = creative.map((i) => i.data);
const yearToProjects = projects.reduce(
  (a, i) => {
    const year = i.yearStart;
    return {
      ...a,
      [year]: [...(a[year] || []), i],
    };
  },
  {} as Record<string, InferEntrySchema<"creative">[]>,
);

const years = Object.keys(yearToProjects);
const groups = years
  .map((year) => ({
    year,
    projects: yearToProjects[year],
  }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<Layout title="creative" description="creative that i've worked on.">
  <main class="section">
    <div class="content">
      <p class="description">
        Creative work for others and my personal projects.
      </p>
      {
        groups.map((group) => (
          <div class="group">
            <span class="year">{group.year}</span>

            <ul>
              {group.projects.map((p) => (
                <ProjectCard {...p} />
              ))}
            </ul>
          </div>
        ))
      }
      <div class="group">
        <span class="year">2018-2024</span>

        <p class="dayjobbing">
          Mostly my day job ^-^ I have lots of either smaller
          projects or OSS work on my <a
            href="https://github.com/finleygn"
            target="_blank">GitHub</a
          >.
        </p>
      </div>
    </div>
  </main>

  <style>
    .description {
      margin-bottom: 2rem;
    }

    .group {
      position: relative;
      padding-left: 18px;

      margin-bottom: 3.5rem;
      margin-left: -18px;
    }

    .year {
      padding-left: 6px;
      margin-left: -6px;
      font-style: italic;
      background: white;
      color: var(--foregroundFaint);
    }

    .year::before {
      content: "";
      border-style: solid;
      border-color: var(--foregroundFaint);
      border-width: 1px 0px 0px 1px;
      border-top-left-radius: 12px;

      position: absolute;
      left: 0;
      top: 7px;
      height: min(100%, 500px);
      width: 37px;
      z-index: -1;
    }

    .year::after {
      content: "";
      background: linear-gradient(to top, white 0%, transparent 100%);
      width: 5px;
      left: 0;
      top: 8px;
      position: absolute;
      height: min(100%, 501px);
    }

    .dayjobbing {
    }

    h2 {
      font-weight: 300;
    }

    ul {
      flex: 1;
      list-style-type: none;
      padding: 0;
      margin: 0;
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    article {
      margin-top: 3rem;
    }

    .dayjobbing {
      max-width: 500px;
      opacity: 0.8;
      margin-top: 12px;
    }
  </style>
</Layout>
