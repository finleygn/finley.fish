---
import type { InferEntrySchema } from "astro:content";

interface Props extends InferEntrySchema<"creative"> {}
const p = Astro.props;
---

<li>
    <div class="image-box">
        <img src={p.image.src} />
    </div>

    <div class="content">
    <h3>{p.title}</h3>
    <p>{p.description}</p>

    {
      p.link && (
        <a href={p.link} target="_blank">
          view
        </a>
      )
    }
  </div>
</li>

<style>
  a {
    opacity: 0.7;
    text-decoration: none;
    font-family: arial;
    font-size: 0.8rem;
  }

  img {
      width:100%;
      z-index: -1;


  }

  .image-box {
      position: relative;
      aspect-ratio: 2/1;
      z-index: 0;
      width: 140px;
      border: 1px solid #fff;
      border-radius: 13px;
      box-shadow: 0px 0px 0px 1px #ccc;
      overflow: hidden;

  }

  .image-box::before {
      content: '';
      position: absolute;
      border-radius: 12px;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      box-shadow: inset 2px 2px 5px 6px #fff;
      opacity: 0.5;
  }

  .image-box::after {
      content: '';
      position: absolute;
      border-radius: 12px;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      box-shadow: inset -2px -2px 5px 5px #000;
      opacity: 0.8;
      mix-blend-mode: overlay;
  }

  li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  h3 {
    font-weight: 300;
    font-size: 1.1rem;
  }

  p {
    max-width: 40ch;
    margin-top: 0.2rem;
    margin-bottom: 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.1;
    font-family: arial;
  }
  span {
    color: #888;
    display: block;
  }

  @media only screen and (max-width: 600px) {
    li {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
